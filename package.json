{
  "name": "mediconnect-root",
  "version": "1.0.0",
  "description": "MediConnect — Smart Healthcare & Telemedicine Platform",
  "scripts": {
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
